# Copy this file to .env and fill in real values. .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_USER=auth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=users_db

# --- JWT signing keys (RSA, PKCS#8/X.509 PEM) ---
# Generate a local pair with:
#   openssl genpkey -algorithm RSA -out app.key -outform PEM
#   openssl rsa -pubout -in app.key -out app.pub
# Then paste each file's full content here, keeping the
# -----BEGIN/END----- markers and using \n for line breaks
# (or set them as real multi-line env vars if your shell allows it).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
